# Example env for the Immich Arcane project (tower.local).
# Copy to .env and update values.
IMMICH_VERSION=v3
UPLOAD_LOCATION=/mnt/user/backups/docker-archive/immich
IMMICH_ENV=production
IMMICH_LOG_LEVEL=debug
IMMICH_LOG_FORMAT=console
DB_HOSTNAME=100.116.205.94
DB_DATABASE_NAME=immichdb
DB_USERNAME=immichdb-admin
DB_PASSWORD={IMMICH_DB_PASSWORD}
IMMICH_MACHINE_LEARNING_ENABLED=false
# ioredis:// base64-encoded URI (host/port/redis password/db) — replace whole value
REDIS_URL={IMMICH_REDIS_URL}