# Example env for kanbn (talos-cloud-00).
# Copy to .env and update values.
POSTGRES_URL=postgres://kanbn-admin:{KANBN_DB_PASSWORD}@pgbouncer:5432/kanbn
REDIS_URL=redis://default:{REDIS_PASSWORD}@unraid.internal:6379/1
