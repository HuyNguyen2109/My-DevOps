# dns-system stack environment
# Consumed by the adguardhome-sync service (env_file in compose.yaml).
# NOTE: values containing "$" MUST be single-quoted, otherwise compose
#       interpolates the "$..." sequence and mangles the value.
TZ=Asia/Bangkok
RUN_ON_START=true
CRON=* * * * *
API_DARK_MODE=false
# LOG_LEVEL=info shows each sync run in the logs; error = quiet (errors only)
LOG_LEVEL=error
ORIGIN_URL=http://192.168.1.3:3000
ORIGIN_USERNAME={ADGUARD_SYNC_ORIGIN_USERNAME}
ORIGIN_PASSWORD='{ADGUARD_SYNC_ORIGIN_PASSWORD}'
REPLICA1_URL=http://192.168.1.4:3000
REPLICA1_USERNAME={ADGUARD_SYNC_REPLICA1_USERNAME}
REPLICA1_PASSWORD='{ADGUARD_SYNC_REPLICA1_PASSWORD}'
