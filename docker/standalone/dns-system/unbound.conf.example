# ------------------------------------------------------------------
# Unbound - network-mode config for the "dns-system" Arcane stack
# Host: tower.local (192.168.1.40) - published :5335 -> container :53
# Purpose: recursive + DNSSEC-validating upstream for AdGuard Home
#          (LXC 192.168.1.3), and ONLY for it.
# Loaded via include-toplevel: /etc/unbound/custom.conf.d/*.conf
# Deployed: 2026-10-05
# ------------------------------------------------------------------
server:
    # --- Access control ---
    # The image defaults allow every RFC1918 client. The split netblocks
    # below are more specific, so they take precedence (longest-prefix
    # match) and refuse everything except localhost + the AdGuard LXC.
    access-control: 127.0.0.0/8 allow
    access-control: 192.168.1.3/32 allow
    access-control: 10.0.0.0/9 refuse
    access-control: 10.128.0.0/9 refuse
    access-control: 172.16.0.0/13 refuse
    access-control: 172.24.0.0/13 refuse
    access-control: 192.168.0.0/17 refuse
    access-control: 192.168.128.0/17 refuse

    # --- Transport ---
    do-ip6: no                          # no usable global IPv6 for this host

    # --- Hardening (deltas on top of image defaults) ---
    harden-below-nxdomain: yes          # RFC 8020
    harden-algo-downgrade: yes
    qname-minimisation: yes
    minimal-responses: yes
    rrset-roundrobin: yes
    aggressive-nsec: yes
    hide-identity: yes
    hide-version: yes

    # --- Observability ---
    extended-statistics: yes

remote-control:
    control-enable: yes
    control-interface: /var/unbound/control.sock
