# Example env for DragonflyDB (tower.local representative; talos-cloud-00 uses the same creds).
# Copy to .env and update values.
DFLY_dbfilename=my-dump-{timestamp}
DFLY_requirepass={DFLY_REQUIREPASS}
DFLY_snapshot_cron=0 * * * *
DFLY_maxmemory=1024mb
TZ=Asia/Bangkok
MASTER_DIR=/mnt/user/appdata/docker-stack-data/dragonfly
DFLY_default_lua_flags=allow-undeclared-keys
IMAGE_VERSION=v1.40.0